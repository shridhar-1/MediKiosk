+# ── MediKiosk env template ──────────────────────────────────────────────
+# Copy to .env.local for local dev. On Vercel: Settings → Environment
+# Variables → add the same keys → REDEPLOY (new values need a fresh deploy).
+# Only DATABASE_URL + Firebase are required to boot; everything else
+# degrades gracefully (template AI, mock alerts, Web-Speech voice).
+
+# ── Required ──
+DATABASE_URL=postgresql://user:password@localhost:5432/medikiosk
+NEXT_PUBLIC_FIREBASE_API_KEY=
+NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
+NEXT_PUBLIC_FIREBASE_PROJECT_ID=
+NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
+NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
+NEXT_PUBLIC_FIREBASE_APP_ID=
+
+# ── AI summary engines (pick any; template fallback if all unset) ──
+GROQ_API_KEY=
+GROQ_MODEL=openai/gpt-oss-120b
+GEMINI_API_KEY=
+OLLAMA_BASE_URL=http://localhost:11434
+OLLAMA_MODEL=
+# AI_ENGINE=auto            # force one lane: ollama | groq | gemini
+# AI_ENGINE_SUMMARY=groq,gemini
+# AI_ENGINE_ASK=gemini,groq
+
+# ── Bhashini (Govt of India language AI) ────────────────────────────────
+# Get keys: https://bhashini.ai → sign in → API Keys → your "medikiosk" key.
+#   BHASHINI_USER_ID      = UDYAT KEY   (value starting with "28c…")
+#   BHASHINI_ULCA_API_KEY = INFERENCE   (value starting with "twinZm…")
+# Do NOT use an old ULCA username here — with new dashboard keys the
+# UDYAT KEY *is* the userID. The code tries direct Dhruva inference first
+# (new keys) and falls back to ULCA pipeline discovery (legacy keys).
+BHASHINI_USER_ID=
+BHASHINI_ULCA_API_KEY=
+# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd   # default is fine, omit
+
+# ── Emergency alerts (mock-logged if unset) ──
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USER=
+SMTP_PASS=
+HOSPITAL_ALERT_EMAIL=
+HOSPITAL_ALERT_PHONE=
+HOSPITAL_ALERT_WHATSAPP=
+TWILIO_ACCOUNT_SID=
+TWILIO_AUTH_TOKEN=
+TWILIO_SMS_FROM=
+TWILIO_WHATSAPP_FROM=
+
+# ── Future integrations (slots ready, onboarding in progress) ──
+ABDM_CLIENT_ID=
+ABDM_CLIENT_SECRET=
+ABDM_GATEWAY_URL=
+ABDM_X_HIP_ID=
+ABDM_HIP_NAME=
+HIS_FHIR_URL=
+HIS_FHIR_BASIC_AUTH=
+HIS_API_KEY=
+UIDAI_LICENSE_KEY=
+UIDAI_VAULT_URL=
+UIDAI_EKYC_URL=
